# ─────────────────────────────────────────────────────────────
# Google 서비스 계정 (README의 "1. Google 설정" 참고)
# ─────────────────────────────────────────────────────────────
# 서비스 계정 JSON의 client_email 값
GOOGLE_CLIENT_EMAIL="meet-me@내프로젝트.iam.gserviceaccount.com"
# 서비스 계정 JSON의 private_key 값. 줄바꿈은 \n 문자 그대로 두고 전체를 따옴표로 감쌉니다.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# 조회/등록할 캘린더 ID. 보통 본인 Gmail 주소. (Google 캘린더 설정에서 확인)
GOOGLE_CALENDAR_ID="you@gmail.com"

# ─────────────────────────────────────────────────────────────
# 메일 발송 (https://resend.com — 무료 3,000통/월)
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"
# 발신 주소. Resend에서 도메인 인증을 마쳐야 합니다.
# 도메인 인증 전이라면 onboarding@resend.dev 로 테스트 가능 (본인에게만 발송됨)
MAIL_FROM="약속 잡기 <booking@내도메인.com>"
# 예약 요청 알림을 받을 내 메일 주소
OWNER_EMAIL="you@gmail.com"

# ─────────────────────────────────────────────────────────────
# 보안
# ─────────────────────────────────────────────────────────────
# '수락' 링크 서명용 비밀키. 아래 명령으로 생성:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET="여기에_랜덤한_64자_hex"

# Cloudflare Turnstile (무료 봇 차단). https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAAA..."

# ─────────────────────────────────────────────────────────────
# 사이트 설정
# ─────────────────────────────────────────────────────────────
# 배포 주소 (수락 링크 생성에 사용). 끝에 슬래시 없이.
NEXT_PUBLIC_SITE_URL="https://내도메인.com"
# 확정 후 신청자에게 안내할 카카오톡 오픈채팅 링크
KAKAO_OPENCHAT_URL="https://open.kakao.com/o/xxxxxxx"
